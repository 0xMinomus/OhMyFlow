{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OhMyFlow",
  "version": "2.0.0",
  "identifier": "com.ohmyflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OhMyFlow - AI Photo Culler",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "decorations": false,
        "backgroundColor": "#0a0a0b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' media: http://media.localhost https://media.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis"],
    "icon": [
      "../build/icon-512.png",
      "../build/icon.ico"
    ]
  }
}
